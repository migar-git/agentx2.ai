# AgentX2.ai — environment template (NO SECRETS). Copy to `.env` and fill locally.
# Governance: docs/KEY_MANAGEMENT.md · docs/API_CONTRACTS.md
# .env is git-ignored. Never commit real secrets. CI runs secret scanning.

# ---- Site (build-time) ----
SITE_BASE_URL=https://agentx2.ai
# Public, privacy-respecting analytics endpoint (optional; no external calls if unset).
PUBLIC_ANALYTICS_ENDPOINT=
PUBLIC_ANALYTICS_ID=

# ---- Local models (default, local-first) ----
OLLAMA_HOST=http://localhost:11434

# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
OTEL_SERVICE_NAME=agentx2-web

# ---- Optional cloud model providers (only if/when enabled; least privilege) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GOOGLE_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# ---- Platform integrations (future private platform) ----
GITHUB_TOKEN=
CRM_API_KEY=
EMAIL_API_KEY=
VECTOR_DB_URL=

# ---- Platform API auth (future private platform) ----
JWT_SIGNING_KEY=
API_KEY=

# ── Agency identity ─────────────────────────────────────────────
# One identity per repository, "repo-<name>", at each agency hub, issued
# by agency/tools/agency_keys.py. Real values live only in the gitignored .env.
# Hub (myskills): skills, fleet and invocations; scopes read + invoke.
SKILLS_API_URL=http://localhost:8741
MYSKILLS_AGENT_KEY=
# Command center (nodex): graph, agency registry and MCP; viewer.
NODEX_URL=http://localhost:8270
AGENCY_NODEX_TOKEN=
# AI gateway (olaman): OpenAI-compatible inference; developer scope.
OLAMAN_BASE_URL=http://localhost:8030
OLAMAN_API_KEY=
# Agency client identity (not this application's server/admin credentials).
# Provision locally with myskills/scripts/agency_onboard.py; never commit .env.
# Existing client identities are preserved; the repository agent then uses .env.agency.
# Remote clients must trust the hub's TLS CA. Never send keys over plain LAN HTTP.
MYSKILLS_AGENT_ID=
